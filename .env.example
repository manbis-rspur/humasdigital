# Salin berkas ini jadi .env.local, lalu isi nilainya.
# Ambil dari Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kunci Gemini untuk modul Humas & Digital Marketing.
# Ambil di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mesin cadangan, dipakai HANYA saat Gemini menolak terus.
# Boleh dikosongkan — tanpa ini, perilakunya sama seperti dulu:
# pekerjaan berhenti dengan pesan galat dari Gemini.
DEEPSEEK_API_KEY=
